*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body, #root {
  height: 100%;
  width: 100%;
}

body {
  background: #0f0a05;
  color: #e8dcc8;
  font-family: 'Crimson Pro', Georgia, serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

/* Scrollbar */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(212,175,55,0.2); border-radius: 2px; }

/* Section cards in AI response */
.sec {
  margin: 8px 0;
  padding: 10px 13px;
  border-radius: 8px;
  border-left: 3px solid;
  line-height: 1.55;
  font-size: 0.88rem;
}
.sch { background: rgba(139,26,26,0.12); border-color: #8B1A1A; font-weight: 600; }
.san { background: rgba(26,100,60,0.12); border-color: #2a7a4a; }
.ssc { background: rgba(139,96,32,0.12); border-color: #8B6020; }
.str { background: rgba(74,35,90,0.12); border-color: #5a3070; }
.sre { background: rgba(26,58,92,0.12); border-color: #2a4a7a; }

/* Loading dots */
.dots { display: flex; gap: 4px; padding: 4px 0; }
.dot {
  width: 6px; height: 6px;
  background: #d4af37;
  border-radius: 50%;
  animation: bounce 1.2s infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* Message bubbles */
.msg-bubble { margin: 8px 0; max-width: 90%; animation: fadeUp 0.3s ease; }
.msg-bubble.user { margin-left: auto; }
.msg-bubble.assistant { margin-right: auto; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.user-bubble {
  background: linear-gradient(135deg, #8B1A1A, #5C1010);
  color: #f5e6d0;
  padding: 10px 14px;
  border-radius: 16px 16px 4px 16px;
  font-family: 'Crimson Pro', serif;
  font-size: 0.95rem;
  line-height: 1.5;
}

.ai-bubble {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.09);
  color: #e8dcc8;
  padding: 14px;
  border-radius: 16px 16px 16px 4px;
  font-family: 'Crimson Pro', serif;
  font-size: 0.88rem;
  line-height: 1.6;
}

/* Buttons */
.lang-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 12px 6px;
  border-radius: 12px;
  border: 1px solid rgba(212,175,55,0.22);
  background: rgba(255,255,255,0.04);
  color: #f0e6d0;
  cursor: pointer;
  transition: all 0.2s;
  text-align: center;
  width: 100%;
}
.lang-btn:hover {
  background: rgba(212,175,55,0.12);
  border-color: rgba(212,175,55,0.5);
  transform: translateY(-2px);
}
.lang-btn.ph {
  border-color: rgba(0,56,168,0.35);
  background: rgba(0,56,168,0.06);
}
.lang-btn.ph:hover {
  background: rgba(0,56,168,0.14);
  border-color: rgba(206,17,38,0.5);
}

.lang-flag { font-size: 1.5rem; }
.lang-local {
  font-size: 0.78rem;
  font-family: 'Crimson Pro', serif;
  font-weight: 600;
  color: #f0e6d0;
  line-height: 1.2;
}
.lang-eng {
  font-size: 0.6rem;
  color: rgba(212,175,55,0.5);
  font-family: 'Cinzel', serif;
  letter-spacing: 0.04em;
}

.lang-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
  background: rgba(212,175,55,0.1);
  border: 1px solid rgba(212,175,55,0.3);
  border-radius: 8px;
  color: #d4af37;
  cursor: pointer;
  padding: 5px 10px;
  font-family: 'Crimson Pro', serif;
  font-size: 0.9rem;
  transition: all 0.2s;
  min-width: 52px;
}
.lang-pill:hover { background: rgba(212,175,55,0.2); }
.lang-pill-name {
  font-size: 0.6rem;
  font-family: 'Cinzel', serif;
  letter-spacing: 0.04em;
  color: rgba(212,175,55,0.7);
}

.cat-btn {
  padding: 14px 10px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.05);
  color: #f0e6d0;
  cursor: pointer;
  text-align: center;
  transition: all 0.2s;
  font-family: 'Crimson Pro', serif;
  font-size: 0.85rem;
  width: 100%;
}
.cat-btn:hover { background: rgba(255,255,255,0.1); transform: translateY(-2px); }
.cat-btn .cat-icon { font-size: 1.6rem; display: block; margin-bottom: 4px; }

.quick-chip {
  padding: 7px 13px;
  border-radius: 20px;
  border: 1px solid rgba(212,175,55,0.3);
  background: rgba(212,175,55,0.07);
  color: #d4af37;
  cursor: pointer;
  font-family: 'Crimson Pro', serif;
  font-size: 0.83rem;
  transition: all 0.2s;
  white-space: nowrap;
}
.quick-chip:hover { background: rgba(212,175,55,0.18); border-color: rgba(212,175,55,0.6); }
.quick-chip.small { font-size: 0.72rem; padding: 5px 10px; }

.text-input {
  flex: 1;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(212,175,55,0.3);
  border-radius: 12px;
  color: #f0e6d0;
  padding: 10px 14px;
  font-family: 'Crimson Pro', serif;
  font-size: 0.95rem;
  resize: none;
  min-height: 44px;
  max-height: 120px;
  outline: none;
}
.text-input:focus { border-color: rgba(212,175,55,0.7); }
.text-input::placeholder { color: rgba(212,175,55,0.4); }

.send-btn {
  background: linear-gradient(135deg, #8B1A1A, #5C1010);
  border: none;
  border-radius: 10px;
  color: #f5e6d0;
  width: 44px;
  height: 44px;
  cursor: pointer;
  font-size: 1.1rem;
  transition: all 0.2s;
  flex-shrink: 0;
}
.send-btn:hover:not(:disabled) { opacity: 0.85; transform: scale(1.05); }
.send-btn:disabled { opacity: 0.35; cursor: not-allowed; }

.back-btn {
  background: none;
  border: none;
  color: rgba(212,175,55,0.7);
  cursor: pointer;
  font-family: 'Crimson Pro', serif;
  font-size: 0.9rem;
  padding: 4px 0;
  display: flex;
  align-items: center;
  gap: 4px;
}
.back-btn:hover { color: #d4af37; }

.section-label {
  font-family: 'Cinzel', serif;
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  color: rgba(212,175,55,0.6);
  margin-bottom: 10px;
}

/* ── Online / Offline status badge ─────────────────────────── */
.status-badge {
  display: inline-block;
  font-size: 0.65rem;
  font-family: 'Cinzel', serif;
  letter-spacing: 0.08em;
  padding: 2px 8px;
  border-radius: 20px;
  margin-top: 3px;
}
.status-badge.online {
  background: rgba(26,100,60,0.2);
  color: #4ade80;
  border: 1px solid rgba(74,222,128,0.3);
}
.status-badge.offline {
  background: rgba(180,80,0,0.2);
  color: #fb923c;
  border: 1px solid rgba(251,146,60,0.3);
}

/* ── Offline banner on home screen ─────────────────────────── */
.offline-banner {
  background: rgba(180,80,0,0.12);
  border: 1px solid rgba(251,146,60,0.25);
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 0.82rem;
  color: rgba(251,180,100,0.9);
  line-height: 1.5;
  margin-bottom: 16px;
  font-style: italic;
}

/* ── Offline notice inside empty chat ──────────────────────── */
.offline-notice {
  margin-top: 12px;
  background: rgba(180,80,0,0.1);
  border: 1px solid rgba(251,146,60,0.2);
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 0.78rem;
  color: rgba(251,180,100,0.8);
  line-height: 1.4;
  font-style: italic;
}
