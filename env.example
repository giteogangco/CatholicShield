# Catholic Shield — environment variables (all optional)
#
# The app works fully without any keys, using its built-in library in src/data/kb/.
#
# To enable AI mode for questions the library doesn't cover, set ONE of these in
# Vercel → Project → Settings → Environment Variables (never in the browser).
# Claude is used when its key is set; otherwise Gemini.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
